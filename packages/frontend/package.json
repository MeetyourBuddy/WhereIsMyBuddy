{
  "name": "buddy_frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint . && prettier --check .",
    "lint:fix": "eslint --fix && prettier --write .",
    "format": "NODE_OPTIONS='--max-old-space-size=4096' prettier --write './**/*.{js,jsx,ts,tsx,css,md,json}' --config ./.prettierrc",
    "preview": "vite preview"
  },
  "lint-staged": {
    "*.{js,ts,tsx,json}": [
      "eslint --fix",
      "prettier --write --ignore-unknown"
    ],
    "*.{tsx,css,html}": [
      "prettier --write --ignore-unknown --plugin prettier-plugin-tailwindcss"
    ]
  },
  "dependencies": {
