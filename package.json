{
  "name": "whereismybuddy",
  "version": "0.0.1",
  "description": "Collaborative study application!",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com:preetisharma0123/WhereIsMyBuddy.git"
  },
  "keywords": [
    "study",
    "buddies",
    "group",
    "collaboration",
    "discord"
  ],
  "author": "The Buddies Gang",
  "scripts": {
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.4.1",
    "@commitlint/config-conventional": "^19.4.1",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.1",
    "husky": "7.0.0",
    "react-router-dom": "^6.26.0"
  },
  "dependencies": {
    "@nestjs/config": "^3.3.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/mongoose": "^10.1.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/swagger": "^8.1.0",
    "bcrypt": "^5.1.1",
    "commitlint": "^19.4.1",
    "express": "^4.21.2",
    "lint-staged": "^15.2.9",
    "mongoose": "^8.8.4",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "swagger-ui-express": "^5.0.1"
  },
  "validate-branch-name": {
    "pattern": "^(([a-z]+(-|\\/))|)((gh-|))[0-9]+(-|\\/)[a-zA-Z0-9]+(-[a-zA-Z0-9]+)*$",
    "errorMsg": "Please check README (section: For errors related to branch name or commit message format) to understand how we name our branches."
  },
  "workspaces": [
    "packages/*"
  ],
  "nohoist": [
    "**/rimraf",
    "**/rimraf/**"
  ]
